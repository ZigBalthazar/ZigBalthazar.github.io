---
import { type Lang } from '../../site.config';
import { useTranslations, plural } from '../i18n/ui';
import { noteHref, topicHref, type TopicGroup } from '../lib/content';
import { localeNum } from '../lib/format';

interface Props { group: TopicGroup; lang: Lang; compact?: boolean }
const { group, lang, compact = false } = Astro.props;
const { topic, notes } = group;
const t = useTranslations(lang);
const first = notes[0];
---
<article class="topic-card">
  <span class="topic-card__eyebrow">
    {topic.data.ordered ? `${t('home.readInOrder')} · ` : ''}{localeNum(notes.length, lang)} {plural(lang, 'home.notes', notes.length)}
  </span>

  <h2 class="topic-card__title"><a href={topicHref(topic)}>{topic.data.title}</a></h2>

  {topic.data.description && <p class="topic-card__desc">{topic.data.description}</p>}

  <ol class="series">
    {notes.map((n, i) => (
      <li class="series__item">
        {topic.data.ordered && !compact && (
          <span class="series__num" aria-hidden="true">{localeNum(i + 1, lang)}</span>
        )}
        <a class="series__link" href={noteHref(n)}>{n.data.title}</a>
      </li>
    ))}
  </ol>

  {topic.data.ordered && first && (
    <div class="topic-card__footer">
      <a class="topic-card__cta" href={noteHref(first)}>{t('home.startFirst')} &rarr;</a>
    </div>
  )}
</article>
